{
  "manifest_version": 3,
  "name": "Kestrel Bridge",
  "version": "0.1.0",
  "description": "Forwards browser downloads and expired-link refreshes to the local Kestrel desktop app.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_bypass.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kestrel Bridge"
  }
}
